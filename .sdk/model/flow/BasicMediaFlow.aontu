# BasicMediaFlow

main: kit: flow: BasicMediaFlow:
{
  entity: "media",
  kind: "basic",
  name: "BasicMediaFlow",
  step: [
    {
      i: {
        ref: "media_ref01",
        srcdatavar: "media_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "media01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-media_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicMediaFlow"
}